# ===========================================================================
# Variables de entorno (SECRETOS)
# ---------------------------------------------------------------------------
# Este archivo NO controla cómo se comporta el bot — solo guarda credenciales.
# Para cambiar la personalidad, el tono o el debounce, edita los archivos en
# la carpeta `configuracion/` (bot.config.yaml y prompt.md).
#
# En Railway estas variables se setean desde el panel del servicio o con el
# CLI: `railway variables --set KEY=VALUE`.
# ===========================================================================

# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL — también usado por pg-boss (no se necesita Redis).
# En Railway esta variable se llena automáticamente con la referencia
# ${{Postgres.DATABASE_URL}} cuando agregas el servicio Postgres al proyecto.
DATABASE_URL=postgresql://user:password@localhost:5432/bot_ghl

# Anthropic (Claude) — empieza con sk-ant-
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Whisper, para transcripción de audios). Opcional — si tu bot no
# recibe audios, déjala vacía.
OPENAI_API_KEY=sk-...

# Go High Level — single tenant
GHL_API_KEY=pit-...
GHL_LOCATION_ID=...

# Webhook secret — defensa anti-spoofing. El bot exige que GHL mande
# este valor como header `x-webhook-secret` en cada llamada al webhook.
# Si se deja vacío, el bot acepta TODOS los webhooks (no recomendado).
# Genera un valor random (ej. `openssl rand -hex 20`) y ponlo también en el
# header del Workflow de GHL que llama al webhook.
WEBHOOK_SECRET=
